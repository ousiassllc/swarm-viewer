<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 以前の自動バックアップ（fullBackupContent）からも全データを除外する。 -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
