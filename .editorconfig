root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.templ]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Kotlin（android/）。ktlint が読む。Kotlin の標準に合わせて 4 スペースにする。
[*.{kt,kts}]
indent_size = 4
ktlint_function_naming_ignore_when_annotated_with = Composable
