{
  "description": "エラー分類 classify（API 仕様 §1.5）。error は none（エラーなし）・network（タイムアウト・DNS・route なしなどの一般のエラー）・invalid_response（応答の解析失敗）・fetch_error（分類済み。fetch_kind・fetch_code）。http_status 0 は HTTP の応答なし。want が null なら成功（分類なし）。kind は ErrKind の種別名。形式は README.md",
  "cases": [
    {"name": "タイムアウト", "error": "network", "http_status": 0, "tool_code": "", "want": {"kind": "unreachable", "code": ""}},
    {"name": "DNS・route なし", "error": "network", "http_status": 0, "tool_code": "", "want": {"kind": "unreachable", "code": ""}},
    {"name": "401", "error": "network", "http_status": 401, "tool_code": "unauthorized", "want": {"kind": "unauthorized", "code": "unauthorized"}},
    {"name": "401 コードなし", "error": "none", "http_status": 401, "tool_code": "", "want": {"kind": "unauthorized", "code": "unauthorized"}},
    {"name": "403", "error": "none", "http_status": 403, "tool_code": "forbidden_scope", "want": {"kind": "forbidden_scope", "code": "forbidden_scope"}},
    {"name": "403 コードなし", "error": "none", "http_status": 403, "tool_code": "", "want": {"kind": "forbidden_scope", "code": "forbidden_scope"}},
    {"name": "404", "error": "none", "http_status": 404, "tool_code": "", "want": {"kind": "protocol", "code": "http_404"}},
    {"name": "405", "error": "none", "http_status": 405, "tool_code": "", "want": {"kind": "protocol", "code": "http_405"}},
    {"name": "413", "error": "none", "http_status": 413, "tool_code": "", "want": {"kind": "protocol", "code": "http_413"}},
    {"name": "404 + コード", "error": "none", "http_status": 404, "tool_code": "not_found", "want": {"kind": "protocol", "code": "not_found"}},
    {"name": "500", "error": "none", "http_status": 500, "tool_code": "", "want": {"kind": "protocol", "code": "http_500"}},
    {"name": "429", "error": "none", "http_status": 429, "tool_code": "", "want": {"kind": "protocol", "code": "http_429"}},
    {"name": "400 invalid_args はセッション不在", "error": "none", "http_status": 400, "tool_code": "invalid_args", "want": {"kind": "session_missing", "code": "invalid_args"}},
    {"name": "500 internal はホスト側エラー", "error": "none", "http_status": 500, "tool_code": "internal", "want": {"kind": "host_error", "code": "internal"}},
    {"name": "session_required", "error": "none", "http_status": 200, "tool_code": "session_required", "want": {"kind": "session_required", "code": "session_required"}},
    {"name": "session_forbidden", "error": "none", "http_status": 200, "tool_code": "session_forbidden", "want": {"kind": "session_forbidden", "code": "session_forbidden"}},
    {"name": "invalid_args", "error": "none", "http_status": 200, "tool_code": "invalid_args", "want": {"kind": "session_missing", "code": "invalid_args"}},
    {"name": "tmux_error", "error": "none", "http_status": 200, "tool_code": "tmux_error", "want": {"kind": "host_error", "code": "tmux_error"}},
    {"name": "internal", "error": "none", "http_status": 200, "tool_code": "internal", "want": {"kind": "host_error", "code": "internal"}},
    {"name": "status 0 のツールコード", "error": "none", "http_status": 0, "tool_code": "tmux_error", "want": {"kind": "host_error", "code": "tmux_error"}},
    {"name": "未知のコード", "error": "none", "http_status": 200, "tool_code": "some_new_code", "want": {"kind": "protocol", "code": "some_new_code"}},
    {"name": "unauthorized ツールコード", "error": "none", "http_status": 200, "tool_code": "unauthorized", "want": {"kind": "unauthorized", "code": "unauthorized"}},
    {"name": "応答の JSON が想定外", "error": "invalid_response", "http_status": 200, "tool_code": "", "want": {"kind": "protocol", "code": ""}},
    {"name": "コードに本文らしき文字列は捨てる", "error": "none", "http_status": 200, "tool_code": "bad code: token=test-token-not-secret", "want": {"kind": "protocol", "code": ""}},
    {"name": "コードが 65 文字は捨てる", "error": "none", "http_status": 200, "tool_code": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "want": {"kind": "protocol", "code": ""}},
    {"name": "コード 64 文字は可", "error": "none", "http_status": 200, "tool_code": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "want": {"kind": "protocol", "code": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}},
    {"name": "大文字コードは不可", "error": "none", "http_status": 200, "tool_code": "Tmux_Error", "want": {"kind": "protocol", "code": ""}},
    {"name": "401 に不正コード", "error": "none", "http_status": 401, "tool_code": "<script>", "want": {"kind": "unauthorized", "code": "unauthorized"}},
    {"name": "成功", "error": "none", "http_status": 200, "tool_code": "", "want": null},
    {"name": "成功 (204)", "error": "none", "http_status": 204, "tool_code": "", "want": null},
    {"name": "既に FetchError なら素通し", "error": "fetch_error", "http_status": 0, "tool_code": "", "want": {"kind": "session_forbidden", "code": "session_forbidden"}, "fetch_kind": "session_forbidden", "fetch_code": "session_forbidden"}
  ]
}
