{
  "description": "通知判定 detect（ER §3.4）。known は通知済みの (pane_id, state)、notify・insert・delete は期待する操作（通知は pane_id と state だけ比べる）。detect_cycles は Diff を known に適用しながら 1 ペインを観測し、各ステップの通知の件数を比べる。形式は README.md",
  "cases": [
    {"name": "asking で行なし: Insert し通知する", "known": [], "panes": [{"id": "%1", "pos": "T%1", "state": "asking"}], "baselining": false, "notify": [{"pane_id": "%1", "state": "asking"}], "insert": [{"pane_id": "%1", "state": "asking"}], "delete": []},
    {"name": "stalled で行なし: Insert し通知する", "known": [], "panes": [{"id": "%1", "pos": "T%1", "state": "stalled"}], "baselining": false, "notify": [{"pane_id": "%1", "state": "stalled"}], "insert": [{"pane_id": "%1", "state": "stalled"}], "delete": []},
    {"name": "asking → asking: 何もしない（再通知なし）", "known": [{"pane_id": "%1", "state": "asking"}], "panes": [{"id": "%1", "pos": "T%1", "state": "asking"}], "baselining": false, "notify": [], "insert": [], "delete": []},
    {"name": "stalled → stalled: 何もしない", "known": [{"pane_id": "%1", "state": "stalled"}], "panes": [{"id": "%1", "pos": "T%1", "state": "stalled"}], "baselining": false, "notify": [], "insert": [], "delete": []},
    {"name": "通知対象外へ離脱: 行をすべて Delete", "known": [{"pane_id": "%1", "state": "asking"}], "panes": [{"id": "%1", "pos": "T%1", "state": "working"}], "baselining": false, "notify": [], "insert": [], "delete": [{"pane_id": "%1", "state": "asking"}]},
    {"name": "離脱後の再突入は再通知: 離脱の Delete 適用後の次の観測で Insert・通知", "known": [], "panes": [{"id": "%1", "pos": "T%1", "state": "asking"}], "baselining": false, "notify": [{"pane_id": "%1", "state": "asking"}], "insert": [{"pane_id": "%1", "state": "asking"}], "delete": []},
    {"name": "asking → stalled: 別状態の行を Delete し、新状態を Insert・通知", "known": [{"pane_id": "%1", "state": "asking"}], "panes": [{"id": "%1", "pos": "T%1", "state": "stalled"}], "baselining": false, "notify": [{"pane_id": "%1", "state": "stalled"}], "insert": [{"pane_id": "%1", "state": "stalled"}], "delete": [{"pane_id": "%1", "state": "asking"}]},
    {"name": "stalled → asking も通知", "known": [{"pane_id": "%1", "state": "stalled"}], "panes": [{"id": "%1", "pos": "T%1", "state": "asking"}], "baselining": false, "notify": [{"pane_id": "%1", "state": "asking"}], "insert": [{"pane_id": "%1", "state": "asking"}], "delete": [{"pane_id": "%1", "state": "stalled"}]},
    {"name": "ペインが消えた: Delete・通知なし", "known": [{"pane_id": "%1", "state": "asking"}, {"pane_id": "%2", "state": "stalled"}], "panes": [{"id": "%2", "pos": "T%2", "state": "stalled"}], "baselining": false, "notify": [], "insert": [], "delete": [{"pane_id": "%1", "state": "asking"}]},
    {"name": "panes が空: 全行 Delete", "known": [{"pane_id": "%1", "state": "asking"}, {"pane_id": "%2", "state": "stalled"}], "panes": [], "baselining": false, "notify": [], "insert": [], "delete": [{"pane_id": "%1", "state": "asking"}, {"pane_id": "%2", "state": "stalled"}]},
    {"name": "known・panes ともに空", "known": [], "panes": [], "baselining": false, "notify": [], "insert": [], "delete": []},
    {"name": "idle / shell / unknown / working は記録も通知もしない", "known": [], "panes": [{"id": "%1", "pos": "T%1", "state": "idle"}, {"id": "%2", "pos": "T%2", "state": "shell"}, {"id": "%3", "pos": "T%3", "state": "unknown"}, {"id": "%4", "pos": "T%4", "state": "working"}], "baselining": false, "notify": [], "insert": [], "delete": []},
    {"name": "unknown へ離脱も Delete", "known": [{"pane_id": "%1", "state": "stalled"}], "panes": [{"id": "%1", "pos": "T%1", "state": "unknown"}], "baselining": false, "notify": [], "insert": [], "delete": [{"pane_id": "%1", "state": "stalled"}]},
    {"name": "未知の state は unknown と同じ扱いで離脱", "known": [{"pane_id": "%1", "state": "asking"}], "panes": [{"id": "%1", "pos": "T%1", "state": "brand-new-state"}], "baselining": false, "notify": [], "insert": [], "delete": [{"pane_id": "%1", "state": "asking"}]},
    {"name": "baselining: Insert のみで通知しない", "known": [], "panes": [{"id": "%1", "pos": "T%1", "state": "asking"}, {"id": "%2", "pos": "T%2", "state": "stalled"}, {"id": "%3", "pos": "T%3", "state": "working"}], "baselining": true, "notify": [], "insert": [{"pane_id": "%1", "state": "asking"}, {"pane_id": "%2", "state": "stalled"}], "delete": []},
    {"name": "baselining: 状態変化も通知せず Insert・Delete", "known": [{"pane_id": "%1", "state": "asking"}], "panes": [{"id": "%1", "pos": "T%1", "state": "stalled"}], "baselining": true, "notify": [], "insert": [{"pane_id": "%1", "state": "stalled"}], "delete": [{"pane_id": "%1", "state": "asking"}]},
    {"name": "baselining: 記録済みは何もしない", "known": [{"pane_id": "%1", "state": "asking"}], "panes": [{"id": "%1", "pos": "T%1", "state": "asking"}], "baselining": true, "notify": [], "insert": [], "delete": []},
    {"name": "複数ペインの混在（notify・insert は panes の順、delete は known の順）", "known": [{"pane_id": "%1", "state": "asking"}, {"pane_id": "%2", "state": "asking"}, {"pane_id": "%3", "state": "stalled"}], "panes": [{"id": "%1", "pos": "T%1", "state": "asking"}, {"id": "%2", "pos": "T%2", "state": "idle"}, {"id": "%4", "pos": "T%4", "state": "stalled"}, {"id": "%3", "pos": "T%3", "state": "asking"}], "baselining": false, "notify": [{"pane_id": "%4", "state": "stalled"}, {"pane_id": "%3", "state": "asking"}], "insert": [{"pane_id": "%4", "state": "stalled"}, {"pane_id": "%3", "state": "asking"}], "delete": [{"pane_id": "%2", "state": "asking"}, {"pane_id": "%3", "state": "stalled"}]},
    {"name": "ID が空のペインは無視", "known": [], "panes": [{"id": "", "pos": "", "state": "asking"}], "baselining": false, "notify": [], "insert": [], "delete": []},
    {"name": "同じ ID が重複したら最初を採用", "known": [], "panes": [{"id": "%1", "pos": "T%1", "state": "asking"}, {"id": "%1", "pos": "T%1", "state": "stalled"}], "baselining": false, "notify": [{"pane_id": "%1", "state": "asking"}], "insert": [{"pane_id": "%1", "state": "asking"}], "delete": []},
    {"name": "known の重複は Delete も 1 回", "known": [{"pane_id": "%1", "state": "asking"}, {"pane_id": "%1", "state": "asking"}], "panes": [{"id": "%1", "pos": "T%1", "state": "idle"}], "baselining": false, "notify": [], "insert": [], "delete": [{"pane_id": "%1", "state": "asking"}]},
    {"name": "known に通知対象外の不正な行があれば Delete", "known": [{"pane_id": "%1", "state": "idle"}, {"pane_id": "%1", "state": "asking"}], "panes": [{"id": "%1", "pos": "T%1", "state": "asking"}], "baselining": false, "notify": [], "insert": [], "delete": [{"pane_id": "%1", "state": "idle"}]},
    {"name": "pos が変わっても ID が同じなら再通知しない", "known": [{"pane_id": "%1", "state": "asking"}], "panes": [{"id": "%1", "pos": "B3", "state": "asking"}], "baselining": false, "notify": [], "insert": [], "delete": []}
  ],
  "detect_cycles": [
    {"name": "通知は遷移ごとに 1 回（継続は再通知なし・離脱後の再突入は再通知）", "steps": [{"state": "asking", "notify": 1}, {"state": "asking", "notify": 0}, {"state": "asking", "notify": 0}, {"state": "working", "notify": 0}, {"state": "asking", "notify": 1}, {"state": "stalled", "notify": 1}, {"state": "stalled", "notify": 0}, {"state": "idle", "notify": 0}, {"state": "stalled", "notify": 1}]},
    {"name": "unknown を挟んでも離脱として扱う", "steps": [{"state": "stalled", "notify": 1}, {"state": "unknown", "notify": 0}, {"state": "stalled", "notify": 1}]}
  ]
}
