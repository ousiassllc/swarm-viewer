package pages

import (
	"github.com/ousiassllc/swarm-viewer/internal/web/atoms"
	"github.com/ousiassllc/swarm-viewer/internal/web/paths"
)

// navLink は #main を差し替えるアプリ内リンク。JS 無効時のために href も持つ。
templ navLink(href, label string) {
	<a href={ templ.SafeURL(href) } hx-get={ href } hx-target="#main" class="text-link hover-fade text-sm text-ink">{ label }</a>
}

// pageTitle は各画面の見出し。
templ pageTitle(text string) {
	<h1 class="text-lg font-semibold text-ink">{ text }</h1>
}

// homeLink は `/` へ戻るリンク。
templ homeLink(label string) {
	@navLink(paths.Home, label)
}

// blockedNotice は操作できないときの固定文言（警告）。
templ blockedNotice(message string) {
	@atoms.Alert(atoms.AlertProps{Kind: atoms.AlertWarning, Message: message})
}
