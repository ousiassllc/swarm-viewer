package organisms

import (
	"github.com/ousiassllc/swarm-viewer/internal/domain"
	"github.com/ousiassllc/swarm-viewer/internal/web/atoms"
	"github.com/ousiassllc/swarm-viewer/internal/web/format"
	"github.com/ousiassllc/swarm-viewer/internal/web/molecules"
	"time"
)

// UsagePanelProps は UsagePanel の入力。
type UsagePanelProps struct {
	// Usage は report の usage（ホスト全体の値）。
	Usage domain.Usage
	// Stale は直前値の表示中（取得失敗）のとき true。グレーアウトする。
	Stale bool
	// Now は相対時間の基準。
	Now time.Time
}

// usageGray は usage.status が stale、または画面全体が直前値のときグレーアウトする。
func usageGray(p UsagePanelProps) bool {
	return p.Stale || domain.NormalizeUsageStatus(p.Usage.Status) == domain.UsageStale
}

func usageSectionClass(p UsagePanelProps) string {
	if usageGray(p) {
		return "flex flex-col gap-3 rounded-lg border border-border bg-surface p-4 opacity-50 grayscale"
	}
	return "flex flex-col gap-3 rounded-lg border border-border bg-surface p-4"
}

// showsNumbers は数字を出す status（ok・stale）か。unavailable・pending・disabled は出さない（機能要件 §5.1）。
func showsNumbers(status string) bool {
	s := domain.NormalizeUsageStatus(status)
	return s == domain.UsageOK || s == domain.UsageStale
}

// usageStatusAlertKind は ok 以外の usage.status をアラートの種類にする（stale は注意、unavailable はエラー、pending・disabled はお知らせ）。
func usageStatusAlertKind(status string) atoms.AlertKind {
	switch domain.NormalizeUsageStatus(status) {
	case domain.UsageStale:
		return atoms.AlertWarning
	case domain.UsagePending, domain.UsageDisabled:
		return atoms.AlertInfo
	default:
		return atoms.AlertDanger
	}
}

func cursorRowLabel(a domain.CursorAccount) string {
	if l := format.CursorWindowLabel(a.Window); l != "" {
		return l
	}
	return "モデル"
}

// UsagePanel は利用上限パネル。usage.status で表示を分ける（機能要件 §5.1）。
//   - ok: 通常表示。fetched_at を小さく併記
//   - stale: グレーアウトして「古いデータ」と fetched_at、reason は折りたたみ
//   - unavailable: 「取得できません」（数字なし。reason は折りたたみ）
//   - pending: 「取得中」（数字なし）
//   - disabled: 「利用上限の取得は無効です」（数字なし）
templ UsagePanel(p UsagePanelProps) {
	<section class={ usageSectionClass(p) } aria-labelledby="usage-heading" data-usage-status={ domain.NormalizeUsageStatus(p.Usage.Status) }>
		<h2 id="usage-heading" class="text-sm font-semibold text-ink">利用上限</h2>
		if label := format.UsageStatusLabel(p.Usage.Status); label != "" {
			@atoms.Alert(atoms.AlertProps{Kind: usageStatusAlertKind(p.Usage.Status), Message: label})
		}
		if showsNumbers(p.Usage.Status) {
			@usageAccounts(p)
			if p.Usage.FetchedAt != nil {
				<p class="text-xs text-mute">{ "最終取得 " + format.DateTime(*p.Usage.FetchedAt) }</p>
			}
		}
		if p.Usage.Reason != "" && (domain.NormalizeUsageStatus(p.Usage.Status) == domain.UsageStale || domain.NormalizeUsageStatus(p.Usage.Status) == domain.UsageUnavailable) {
			<details class="text-sm text-ink">
				<summary>詳細</summary>
				<code class="font-mono">{ p.Usage.Reason }</code>
			</details>
		}
	</section>
}

templ usageAccounts(p UsagePanelProps) {
	for _, a := range p.Usage.Claude {
		@agentAccount("Claude", a, p.Now)
	}
	for _, a := range p.Usage.Codex {
		@agentAccount("Codex", a, p.Now)
	}
	for _, a := range p.Usage.Cursor {
		<div class="flex flex-col gap-2">
			<h3 class="text-sm text-ink">{ format.JoinNonEmpty(" · ", "Cursor", a.Account) }</h3>
			@molecules.UsageRow(molecules.UsageRowProps{Label: cursorRowLabel(a), Slot: a.Models, Now: p.Now})
		</div>
	}
}

// bothSlotsUnavailable は 2 枠とも available: false のアカウントか（「—」を 2 行出さず 1 行にまとめる）。
func bothSlotsUnavailable(a domain.AgentAccount) bool {
	return !a.FiveHour.Available && !a.SevenDay.Available
}

// agentAccount は Claude / Codex のアカウント 1 件。2 枠とも取れないときは「取得できません」を 1 行で出し、
// reason があれば理由を添える（機能要件 §5.2）。片方だけ取れないときは 2 行のまま（取れない枠は「—」）。
templ agentAccount(agent string, a domain.AgentAccount, now time.Time) {
	<div class="flex flex-col gap-2">
		<h3 class="text-sm text-ink">{ format.JoinNonEmpty(" · ", agent, a.Account) }</h3>
		if bothSlotsUnavailable(a) {
			@atoms.Alert(atoms.AlertProps{Kind: atoms.AlertWarning, Message: format.JoinNonEmpty(" · ", "取得できません", format.UsageReasonLabel(a.Reason))})
		} else {
			@molecules.UsageRow(molecules.UsageRowProps{Label: "5 時間枠", Slot: a.FiveHour, Now: now})
			@molecules.UsageRow(molecules.UsageRowProps{Label: "7 日枠", Slot: a.SevenDay, Now: now})
		}
	</div>
}
