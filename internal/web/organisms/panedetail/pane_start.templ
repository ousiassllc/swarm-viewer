package panedetail

import (
	"strings"

	"github.com/ousiassllc/swarm-viewer/internal/domain/ops"
	"github.com/ousiassllc/swarm-viewer/internal/web/atoms"
	"github.com/ousiassllc/swarm-viewer/internal/web/paths"
)

// StartID は新しいセッション画面の本文（差し替え先）の id。DirPickerID はフォルダピッカー、SkillPickerID はスキルの選択部品の id。
const (
	StartID       = "pane-start"
	DirPickerID   = "dir-picker"
	SkillPickerID = "skill-picker"
)

// FieldEdit・FieldPick は新しいセッションの段階を表す form 値・クエリ。FieldConfirm（pane_action.go）があるときだけ pane_start を呼ぶ（無ければ確認画面を返すだけ）。
const (
	FieldEdit = "edit"
	FieldPick = "pick"
)

// StartFormProps は新しいセッションの入力画面の入力。
type StartFormProps struct {
	Ref Ref
	// Agent・Cwd・Title は入力済みの値（確認画面から戻ったとき）。Cwd が空でなければフォルダは選択済みの表示で出す。
	Agent string
	Cwd   string
	Title string
	// Skill（skill_list の invoke）・Task（本文）は最初のタスクの入力済みの値（任意）。Skill が空でなければ選択済みの表示で出す。
	Skill string
	Task  string
	// Notice は失敗の固定文言（インラインのアラート）。
	Notice string
	// Recent は「最近使ったフォルダ」（ピッカーの最上位に出す）。
	Recent []string
}

// StartConfirmProps は確認画面の入力。
type StartConfirmProps struct {
	Ref               Ref
	Agent, Cwd, Title string
	// Skill・Task は最初のタスク（任意）。確認画面の要約に出し、hidden で持ち回る。
	Skill, Task string
	// Notice は起動に失敗したときの固定文言（ok:false・操作の失敗）。
	Notice string
}

// StartForm は新しいセッションの入力画面（エージェント → フォルダ → スキル → 本文 → タイトル）。まだ何も送らず、「確認へ」で確認画面に進む。
templ StartForm(p StartFormProps) {
	<div id={ StartID } class="flex min-w-0 flex-col gap-4">
		if p.Notice != "" {
			@atoms.Alert(atoms.AlertProps{Kind: atoms.AlertDanger, Message: p.Notice})
		}
		<form
			class="flex flex-col gap-5"
			hx-post={ paths.PaneStart(p.Ref.ConnectionID, p.Ref.Session, p.Ref.Pos) }
			hx-target={ "#" + StartID }
			hx-swap="outerHTML"
			hx-disabled-elt="find button[type=submit]"
		>
			<fieldset class="flex flex-col gap-2">
				<legend class="mb-1 text-sm font-semibold text-ink">1. エージェント</legend>
				<div class="grid gap-2 sm:grid-cols-3">
					for _, a := range ops.StartAgents {
						<label class="flex min-h-12 cursor-pointer items-center gap-2 rounded-md border border-border px-4 py-2 text-base text-ink has-checked:border-accent has-checked:bg-accent-soft has-focus-visible:ring-2 has-focus-visible:ring-(color:--ring)">
							<input type="radio" name={ FieldAgent } value={ a } checked?={ a == p.Agent } required class="size-4 accent-(--accent)" { skillsGet(p.Ref, a, "change")... }/>
							<span>{ a }</span>
						</label>
					}
				</div>
			</fieldset>
			<section class="flex flex-col gap-2" aria-label="フォルダ">
				<h2 class="text-sm font-semibold text-ink">2. フォルダ</h2>
				<div id={ DirPickerID }>
					if p.Cwd != "" {
						@DirSelected(p.Ref, p.Cwd)
					} else {
						@DirPickerLoad(p.Ref)
					}
				</div>
			</section>
			<section class="flex flex-col gap-2" aria-label="スキル">
				<h2 class="text-sm font-semibold text-ink">3. スキル（任意）</h2>
				<div id={ SkillPickerID } aria-live="polite">
					if p.Agent == "" {
						<p class="text-sm text-mute">エージェントを選ぶと、スキルを選べます</p>
					} else if p.Skill != "" {
						@SkillSelected(p.Ref, p.Agent, p.Skill)
					} else {
						@SkillPickerLoad(p.Ref, p.Agent)
					}
				</div>
			</section>
			<div class="flex flex-col gap-2">
				<label for="pane-start-task" class="text-sm font-semibold text-ink">4. 本文（任意）</label>
				@atoms.Textarea(atoms.TextareaProps{ID: "pane-start-task", Name: FieldTask, Rows: "4", Value: p.Task})
			</div>
			<div class="flex flex-col gap-2">
				<label for="pane-start-title" class="text-sm font-semibold text-ink">5. タイトル（1〜80 字）</label>
				<input id="pane-start-title" name={ FieldTitle } value={ p.Title } required maxlength="80" autocomplete="off" class={ atoms.FieldClass, "w-full px-3" }/>
			</div>
			<div class="flex flex-wrap items-center gap-3">
				@atoms.Button(atoms.ButtonProps{Label: "確認へ", Type: "submit", Variant: atoms.ButtonPrimary})
				<a href={ templ.SafeURL(paths.Pane(p.Ref.ConnectionID, p.Ref.Session, p.Ref.Pos)) } hx-get={ paths.Pane(p.Ref.ConnectionID, p.Ref.Session, p.Ref.Pos) } hx-target="#main" class="text-link hover-fade text-sm text-ink">やめる</a>
			</div>
		</form>
	</div>
}

// DirPickerLoad はフォルダピッカーの最初の読み込み（許可されたフォルダの根を dir_list で取る）。
templ DirPickerLoad(ref Ref) {
	<div
		class="flex items-center gap-2 text-sm text-ink"
		hx-get={ paths.PaneStartDirs(ref.ConnectionID, ref.Session, ref.Pos) }
		hx-trigger="load"
		hx-target={ "#" + DirPickerID }
		hx-swap="innerHTML"
	>
		@atoms.Spinner(atoms.SpinnerProps{})
		<span role="status">フォルダを読み込み中…</span>
	</div>
}

// DirSelected は選択済みのフォルダ。cwd を hidden で持ち、「変更」でピッカーを開き直す。
templ DirSelected(ref Ref, cwd string) {
	<div class="flex flex-wrap items-center gap-2 rounded-md border border-border bg-surface p-3" data-dir-selected>
		<input type="hidden" name={ FieldCwd } value={ cwd }/>
		<span class="min-w-0 flex-1 break-all font-mono text-sm text-ink">{ cwd }</span>
		@atoms.Button(atoms.ButtonProps{Label: "変更", Size: atoms.ButtonSmall, Attrs: dirsGet(ref, "", false)})
	</div>
}

// StartConfirm は確認画面（エージェント・フォルダ・タイトル・スキル・本文の先頭の要約）。「起動する」で初めて pane_start を呼ぶ。
// 値は hidden で持ち回り、「戻って直す」で入力画面に戻る。
templ StartConfirm(p StartConfirmProps) {
	<div id={ StartID } class="flex min-w-0 flex-col gap-4">
		if p.Notice != "" {
			@atoms.Alert(atoms.AlertProps{Kind: atoms.AlertDanger, Message: p.Notice})
		}
		<form
			class="flex flex-col gap-4"
			hx-post={ paths.PaneStart(p.Ref.ConnectionID, p.Ref.Session, p.Ref.Pos) }
			hx-target={ "#" + StartID }
			hx-swap="outerHTML"
			hx-disabled-elt="find button"
			hx-indicator="#pane-start-spinner"
		>
			<input type="hidden" name={ FieldAgent } value={ p.Agent }/>
			<input type="hidden" name={ FieldCwd } value={ p.Cwd }/>
			<input type="hidden" name={ FieldTitle } value={ p.Title }/>
			<input type="hidden" name={ FieldSkill } value={ p.Skill }/>
			<input type="hidden" name={ FieldTask } value={ p.Task }/>
			<h2 class="text-sm font-semibold text-ink">6. 確認</h2>
			<dl class="grid grid-cols-[6rem_1fr] gap-x-3 gap-y-2 rounded-md border border-border bg-bone p-4 text-sm" data-start-summary>
				<dt class="text-mute">エージェント</dt>
				<dd class="text-ink">{ p.Agent }</dd>
				<dt class="text-mute">フォルダ</dt>
				<dd class="break-all font-mono text-ink">{ p.Cwd }</dd>
				<dt class="text-mute">タイトル</dt>
				<dd class="break-words text-ink">{ p.Title }</dd>
				if p.Skill != "" {
					<dt class="text-mute">スキル</dt>
					<dd class="break-all font-mono text-ink" data-start-skill>{ p.Skill }</dd>
				}
				if p.Task != "" {
					<dt class="text-mute">本文</dt>
					<dd class="whitespace-pre-wrap break-words text-ink" data-start-task>{ taskPreview(p.Task) }</dd>
				}
			</dl>
			<div class="flex flex-wrap items-center gap-3">
				@atoms.Spinner(atoms.SpinnerProps{ID: "pane-start-spinner"})
				@atoms.Button(atoms.ButtonProps{Label: "起動する", Type: "submit", Variant: atoms.ButtonPrimary, Attrs: templ.Attributes{"name": FieldConfirm, "value": "1"}})
				@atoms.Button(atoms.ButtonProps{Label: "戻って直す", Type: "submit", Attrs: templ.Attributes{"name": FieldEdit, "value": "1"}})
			</div>
		</form>
	</div>
}

// DirPickerProps はフォルダピッカーの一覧の入力。
type DirPickerProps struct {
	Ref Ref
	// Path は一覧しているフォルダ。空なら許可されたフォルダの根（allowed_roots）。
	Path string
	Dir  ops.DirList
	// Recent は「最近使ったフォルダ」。根の一覧にだけ出す。
	Recent []string
	// Error は dir_list の失敗の固定文言。空なら一覧を出す。
	Error string
}

func dirsGet(ref Ref, path string, pick bool) templ.Attributes {
	u := paths.PaneStartDirs(ref.ConnectionID, ref.Session, ref.Pos) + "?" + FieldPath + "=" + queryEscape(path)
	if pick {
		u += "&" + FieldPick + "=1"
	}
	return templ.Attributes{"hx-get": u, "hx-target": "#" + DirPickerID, "hx-swap": "innerHTML"}
}

// parentDir は path の 1 つ上。根（/）や 1 階層目の上は空（許可されたフォルダの根へ戻る）。
func parentDir(path string) string {
	i := strings.LastIndex(strings.TrimRight(path, "/"), "/")
	if i <= 0 {
		return ""
	}
	return path[:i]
}

// DirPicker はフォルダピッカーの一覧（パンくず・1 つ上へ・このフォルダを選ぶ・各行をタップで下へ）。
// 名前・パスはホストの応答で、文字列として描画する。git のフォルダには印、truncated なら「一部のみ表示」。
templ DirPicker(p DirPickerProps) {
	<div class="flex min-w-0 flex-col gap-2" data-dir-picker>
		if p.Error != "" {
			@atoms.Alert(atoms.AlertProps{Kind: atoms.AlertDanger, Message: p.Error})
		}
		if p.Path != "" {
			<p class="break-all font-mono text-xs text-mute" data-dir-path>{ p.Path }</p>
			<div class="flex flex-wrap gap-2">
				@atoms.Button(atoms.ButtonProps{Label: "1 つ上へ", Size: atoms.ButtonSmall, Attrs: dirsGet(p.Ref, parentDir(p.Path), false)})
				@atoms.Button(atoms.ButtonProps{Label: "このフォルダを選ぶ", Size: atoms.ButtonSmall, Variant: atoms.ButtonPrimary, Attrs: dirsGet(p.Ref, p.Path, true)})
			</div>
		} else {
			<p class="text-xs text-mute">選べるフォルダ</p>
		}
		if p.Error == "" {
			if len(p.Dir.Entries) == 0 {
				<p class="text-sm text-mute">フォルダがありません</p>
			}
			<ul class="flex flex-col gap-2">
				for _, e := range p.Dir.Entries {
					<li>
						@atoms.ChoiceButton(dirsGet(p.Ref, e.Path, false)) {
							<span class="min-w-0 flex-1 break-all">{ e.Name }</span>
							if e.Git {
								@atoms.Badge(atoms.BadgeProps{Text: "git", Tone: "muted"})
							}
						}
					</li>
				}
			</ul>
			if p.Dir.Truncated {
				<p class="text-xs text-mute">一部のみ表示</p>
			}
		}
		if p.Path == "" && len(p.Recent) > 0 {
			<h3 class="mt-2 text-sm font-semibold text-ink">最近使ったフォルダ</h3>
			<ul class="flex flex-col gap-2" data-recent-folders>
				for _, r := range p.Recent {
					<li>
						@atoms.ChoiceButton(dirsGet(p.Ref, r, true)) {
							<span class="min-w-0 flex-1 break-all font-mono text-sm">{ r }</span>
						}
					</li>
				}
			</ul>
		}
	</div>
}
