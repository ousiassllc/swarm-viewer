package organisms

import (
	"github.com/ousiassllc/swarm-viewer/internal/domain"
	"github.com/ousiassllc/swarm-viewer/internal/web/atoms"
	"github.com/ousiassllc/swarm-viewer/internal/web/format"
	"github.com/ousiassllc/swarm-viewer/internal/web/paths"
)

// ConnectionListID は接続一覧の id（削除の応答で outerHTML を差し替える先）。
const ConnectionListID = "connection-list"

// ConnectionListProps は ConnectionList の入力。
type ConnectionListProps struct {
	// Connections は保存済みの接続。token は持たない。表示は表示名と URL の host のみ。
	Connections []domain.Connection
	// CurrentID は表示中の接続 ID。空なら印を付けない。
	CurrentID string
	// Error は一覧の上に出すインラインアラートの固定文言（削除失敗など）。空なら出さない。
	Error string
}

func deleteConfirm(name string) string {
	return "接続「" + name + "」を削除します。保存した token も消えます。よろしいですか？"
}

// ConnectionList は保存済み接続の一覧（表示名・host・切替・削除）。削除は hx-confirm で確認する。
templ ConnectionList(p ConnectionListProps) {
	<div id={ ConnectionListID } class="flex flex-col gap-4">
		if p.Error != "" {
			@atoms.Alert(atoms.AlertProps{Kind: atoms.AlertDanger, Message: p.Error})
		}
		if len(p.Connections) == 0 {
			@atoms.EmptyState(atoms.EmptyStateProps{Message: "保存済みの接続はありません"}) {
				@atoms.Button(atoms.ButtonProps{Label: "接続を追加", Variant: atoms.ButtonPrimary, Size: atoms.ButtonSmall, Attrs: templ.Attributes{
					"hx-get":    paths.Pairing,
					"hx-target": "#main",
				}})
			}
		} else {
			<ul class="flex flex-col divide-y divide-border rounded-lg border border-border bg-surface">
				for _, c := range p.Connections {
					<li class="flex items-center gap-3 px-4 py-3">
						<div class="flex min-w-0 flex-1 flex-col gap-(--list-title-caption-gap)">
							<p class="truncate text-sm text-ink" title={ c.Name }>{ c.Name }</p>
							<p class="truncate font-mono text-xs text-mute">{ c.Host() }</p>
						</div>
						<div class="flex items-center gap-2">
							if c.ID == p.CurrentID {
								@atoms.Badge(atoms.BadgeProps{Text: "表示中", Tone: format.ToneAccent, Marker: true})
							} else {
								@atoms.Button(atoms.ButtonProps{Label: "切替", Size: atoms.ButtonSmall, Attrs: templ.Attributes{
									"hx-get":    paths.Connection(c.ID),
									"hx-target": "#main",
								}})
							}
							@atoms.Button(atoms.ButtonProps{Label: "削除", Variant: atoms.ButtonDanger, Size: atoms.ButtonSmall, Attrs: templ.Attributes{
								"hx-delete":          paths.Connection(c.ID),
								"hx-confirm":         deleteConfirm(c.Name),
								"data-confirm-title": "接続を削除",
								"data-confirm-label": "削除",
								"hx-target":          "#" + ConnectionListID,
								"hx-swap":            "outerHTML",
								"hx-disabled-elt":    "this",
							}})
						</div>
					</li>
				}
			</ul>
		}
	</div>
}
