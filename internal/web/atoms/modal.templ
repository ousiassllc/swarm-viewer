package atoms

// ModalClass は中央モーダル（ネイティブ <dialog>）のクラス（ガイド O1・O2）。
// 角丸 --r-xl（rounded-xl）・1px の --border・--shadow-modal・padding 24。スクラム（::backdrop）の色とフェードは app.css の dialog.modal が持つ。
// 出現は .modal-in（--motion-slow 280ms。アラート・トーストの .fade-in 320ms とは別。ガイド M5）。
// ::backdrop は Tailwind の既定でマージンが 0 になるので、中央寄せの m-auto を付ける。
const ModalClass = "modal-in modal m-auto w-[min(28rem,calc(100vw-2rem))] rounded-xl border border-border bg-surface p-6 text-ink shadow-modal"

// ConfirmDialogID は確認ダイアログの id。static/src/js/app.js が htmx:confirm（hx-confirm）で開く。
const ConfirmDialogID = "confirm-dialog"

// ConfirmDialog は確認・破壊的操作の中央モーダル（ガイド O2）。レイアウトに 1 つだけ置く。
// hx-confirm を持つ要素の操作で app.js が開き、文言を hx-confirm の値、見出しとボタンのラベルを
// その要素の data-confirm-title・data-confirm-label から差し込む（textContent なのでエスケープされる）。
// 「キャンセル」・外側クリック・Esc は何も送らず閉じる。確定ボタンは危険ボタン（--danger）。
// インラインスクリプト・hx-on・eval は使わない（NFR-SEC-9）。
templ ConfirmDialog() {
	<dialog id={ ConfirmDialogID } data-modal aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-message" class={ ModalClass }>
		<div class="flex flex-col gap-4">
			<h2 id="confirm-dialog-title" class="text-lg font-semibold" data-confirm-title>確認</h2>
			<p id="confirm-dialog-message" class="text-sm" data-confirm-message></p>
			<div class="flex items-center justify-end gap-2">
				@Button(ButtonProps{Label: "キャンセル", Size: ButtonSmall, Attrs: templ.Attributes{"data-modal-result": "cancel"}})
				@Button(ButtonProps{Label: "実行", Variant: ButtonDanger, Size: ButtonSmall, Attrs: templ.Attributes{"data-modal-result": "confirm", "data-confirm-action": true}})
			</div>
		</div>
	</dialog>
}
