package atoms

// ButtonVariant はボタンの見た目。
type ButtonVariant string

// ButtonVariant の値。
const (
	ButtonPrimary   ButtonVariant = "primary"
	ButtonSecondary ButtonVariant = "secondary"
	ButtonDanger    ButtonVariant = "danger"
)

// ButtonSize はボタンの大きさ（ガイド O7）。
type ButtonSize string

// ButtonSize の値。ゼロ値は標準（高さ 40・16px）。モーダル・ヘッダー・一覧行の操作は ButtonSmall を明示する。
const (
	ButtonDefault ButtonSize = ""
	ButtonSmall   ButtonSize = "small"
)

// ButtonProps は Button の入力。
type ButtonProps struct {
	// Label は表示文字列。
	Label string
	// Type は button の type。空なら "button"（意図せず submit しない）。
	Type string
	// Variant は見た目。未知の値は secondary。
	Variant ButtonVariant
	// Size は大きさ。空なら標準（高さ 40・padding 18・16px）、ButtonSmall は高さ 32・padding 12・14px。
	Size ButtonSize
	// Attrs は hx-* など追加の属性。値は Templ がエスケープする。
	Attrs templ.Attributes
}

func buttonClass(v ButtonVariant) string {
	switch v {
	case ButtonPrimary:
		return "bg-accent text-bone hover:bg-accent/85"
	case ButtonDanger:
		return "border border-danger/45 bg-transparent text-danger hover:bg-danger/10"
	default:
		return "border border-border bg-transparent text-ink hover:bg-accent-soft"
	}
}

// buttonSizeClass は大きさのクラス。標準は入力欄（min-h-10）と同じ高さ 40、小は高さ 32。
func buttonSizeClass(s ButtonSize) string {
	if s == ButtonSmall {
		return "h-8 px-3 text-sm"
	}
	return "h-10 px-[18px] text-base"
}

func buttonType(t string) string {
	if t == "" {
		return "button"
	}
	return t
}

// Button は共通ボタン。ペインカードでは使わない（読み取り専用）。
templ Button(p ButtonProps) {
	<button
		type={ buttonType(p.Type) }
		class={ "hover-fade relative inline-flex cursor-pointer items-center gap-2 overflow-clip rounded-md font-semibold disabled:cursor-not-allowed disabled:opacity-40", buttonSizeClass(p.Size), buttonClass(p.Variant) }
		{ p.Attrs... }
	>
		{ p.Label }
	</button>
}

// InputProps は Input の入力。
type InputProps struct {
	// ID・Name・Type は input の属性。Type が空なら "text"。
	ID   string
	Name string
	Type string
	// Value は初期値。ペアリング欄など秘密を含みうる入力には渡さない。
	Value string
	// Placeholder は入力例。
	Placeholder string
	// Required は必須入力か。
	Required bool
	// Attrs は追加の属性。
	Attrs templ.Attributes
}

func inputType(t string) string {
	if t == "" {
		return "text"
	}
	return t
}

// FieldClass は入力欄・select・textarea の共通クラス（高さ 40・--r-md・1px border・surface 地・文字 16px）。
// フォーカスは app.css の outline（--focus の 2px）を、フォーム用の ring（--focus の 40%）に置き換える。
// 無効（disabled）は opacity .5・cursor not-allowed（ガイド O7・§4 フォーム）。
// 横幅・padding・フォントは呼び出し側が足す。
const FieldClass = "min-h-10 rounded-md text-base border border-border bg-surface text-ink placeholder:text-mute focus-visible:border-focus focus-visible:outline-transparent focus-visible:ring-2 focus-visible:ring-(color:--ring) disabled:cursor-not-allowed disabled:opacity-50"

// FieldInvalidClass は検証に失敗した入力欄の枠（ガイド O7・tokens-preview の .fld.bad）: --danger の枠、フォーカス中のリングは --danger の 40%（--ring-danger）。
// FieldClass の border・focus の枠色と同じ特異度なので、! で確実に上書きする。リングの色は --ring を要素上で差し替えて変える。
// 文言は入力欄の下の Alert が持つ。
const FieldInvalidClass = "border-danger! focus-visible:border-danger! [--ring:var(--ring-danger)]"

// SelectClass は select 用のクラス。FieldClass に、OS 既定の矢印を消して mute のシェブロンを足したもの（ガイド §4 フォーム）。
// シェブロンは CSP（default-src 'self'）で data: URI が使えないので、ガイドの見本どおり linear-gradient 2 本（5px 四方）で描く。
// 色は var(--mute) でライト・ダークのトークンに追従する。シェブロンの位置ぶん右に 36px（pr-9）空ける。
// 横幅・左 padding は呼び出し側が足す。
const SelectClass = FieldClass + " appearance-none pr-9 bg-no-repeat bg-[image:linear-gradient(45deg,transparent_50%,var(--mute)_50%),linear-gradient(135deg,var(--mute)_50%,transparent_50%)] bg-[position:calc(100%-18px)_50%,calc(100%-13px)_50%] bg-[size:5px_5px]"

// Input は共通の 1 行入力。
templ Input(p InputProps) {
	<input
		id={ p.ID }
		name={ p.Name }
		type={ inputType(p.Type) }
		value={ p.Value }
		placeholder={ p.Placeholder }
		required?={ p.Required }
		autocomplete="off"
		class={ FieldClass, "w-full px-3" }
		{ p.Attrs... }
	/>
}

// ChoiceButtonClass は選択肢の大きなボタン（親指で押せる高さ 48 以上・全幅・折り返し可）。選択肢の文言が長くても崩れない。
const ChoiceButtonClass = "hover-fade relative flex min-h-12 w-full cursor-pointer items-center gap-2 overflow-clip rounded-md border border-border bg-transparent px-4 py-2 text-left text-base text-ink hover:bg-accent-soft disabled:cursor-not-allowed disabled:opacity-40"

// ChoiceButton は質問カードの選択肢などの大きなボタン。中身は子要素（文言・印）に書き、Attrs に hx-* を渡す。
templ ChoiceButton(attrs templ.Attributes) {
	<button type="button" class={ ChoiceButtonClass } { attrs... }>
		{ children... }
	</button>
}

// TextareaProps は Textarea の入力。
type TextareaProps struct {
	// ID・Name は textarea の属性。
	ID   string
	Name string
	// Rows は行数（既定 3）。
	Rows string
	// Label はスクリーンリーダー用の名前（aria-label）。
	Label string
	// Attrs は追加の属性（hx-preserve など）。
	Attrs templ.Attributes
}

func textareaRows(r string) string {
	if r == "" {
		return "3"
	}
	return r
}

// Textarea は共通の複数行入力（FieldClass）。値は戻さない（送信後は空）。
templ Textarea(p TextareaProps) {
	<textarea
		id={ p.ID }
		name={ p.Name }
		rows={ textareaRows(p.Rows) }
		aria-label={ p.Label }
		autocomplete="off"
		spellcheck="false"
		class={ FieldClass, "w-full px-3 py-2" }
		{ p.Attrs... }
	></textarea>
}
