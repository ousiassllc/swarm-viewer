package atoms

// ButtonVariant はボタンの見た目。
type ButtonVariant string

// ButtonVariant の値。
const (
	ButtonPrimary   ButtonVariant = "primary"
	ButtonSecondary ButtonVariant = "secondary"
	ButtonDanger    ButtonVariant = "danger"
)

// ButtonProps は Button の入力。
type ButtonProps struct {
	// Label は表示文字列。
	Label string
	// Type は button の type。空なら "button"（意図せず submit しない）。
	Type string
	// Variant は見た目。未知の値は secondary。
	Variant ButtonVariant
	// Attrs は hx-* など追加の属性。値は Templ がエスケープする。
	Attrs templ.Attributes
}

func buttonClass(v ButtonVariant) string {
	switch v {
	case ButtonPrimary:
		return "bg-accent text-bone hover:bg-accent/85"
	case ButtonDanger:
		return "bg-danger text-bone hover:bg-danger/85"
	default:
		return "border border-border bg-transparent text-ink hover:bg-accent-soft"
	}
}

func buttonType(t string) string {
	if t == "" {
		return "button"
	}
	return t
}

// Button は共通ボタン。ペインカードでは使わない（読み取り専用）。
templ Button(p ButtonProps) {
	<button
		type={ buttonType(p.Type) }
		class={ "relative inline-flex h-8 items-center gap-2 overflow-clip rounded-md px-4 text-sm font-semibold disabled:opacity-40", buttonClass(p.Variant) }
		{ p.Attrs... }
	>
		{ p.Label }
	</button>
}

// InputProps は Input の入力。
type InputProps struct {
	// ID・Name・Type は input の属性。Type が空なら "text"。
	ID   string
	Name string
	Type string
	// Value は初期値。ペアリング欄など秘密を含みうる入力には渡さない。
	Value string
	// Placeholder は入力例。
	Placeholder string
	// Required は必須入力か。
	Required bool
	// Attrs は追加の属性。
	Attrs templ.Attributes
}

func inputType(t string) string {
	if t == "" {
		return "text"
	}
	return t
}

// FieldClass は入力欄・select・textarea の共通クラス（高さ 40・--r-md・1px border・surface 地）。
// フォーカスは app.css の outline（--focus の 2px）を、フォーム用の ring（--focus の 40%）に置き換える。
// 横幅・padding・フォントは呼び出し側が足す。
const FieldClass = "min-h-10 rounded-md border border-border bg-surface text-ink placeholder:text-mute focus-visible:border-focus focus-visible:outline-transparent focus-visible:ring-2 focus-visible:ring-(color:--ring)"

// Input は共通の 1 行入力。
templ Input(p InputProps) {
	<input
		id={ p.ID }
		name={ p.Name }
		type={ inputType(p.Type) }
		value={ p.Value }
		placeholder={ p.Placeholder }
		required?={ p.Required }
		autocomplete="off"
		class={ FieldClass, "w-full px-3 text-sm" }
		{ p.Attrs... }
	/>
}
