package atoms

// AlertKind はインラインアラートの種類（ガイドの お知らせ / 成功 / 注意 / エラー）。
type AlertKind string

// AlertKind の値。
const (
	AlertInfo    AlertKind = "info"
	AlertSuccess AlertKind = "success"
	AlertWarning AlertKind = "warning"
	AlertDanger  AlertKind = "danger"
)

// AlertProps は Alert の入力。
type AlertProps struct {
	// Kind は種類。未知の値は danger。
	Kind AlertKind
	// Title は見出し（SemiBold・14px）。空なら出さない。見出しを持つときは、詳しい内容を Message か子要素に書く。
	Title string
	// Message は本文。複数行・リンクなどを載せるときは空にして、子要素に書く。
	Message string
	// Attrs は data-* など追加の属性。値は Templ がエスケープする。
	Attrs templ.Attributes
}

// alertClass はガイドの見本（tokens-preview の .al）の形: surface 地・1px の border・左 3px の状態色・--r-md・文字は ink。状態色はアイコンと左の帯だけに使う。
func alertClass(k AlertKind) string {
	const base = "fade-in flex items-start gap-3 rounded-md border border-border border-l-[3px] bg-surface px-4 py-3 text-sm text-ink "
	switch k {
	case AlertInfo:
		return base + "border-l-info"
	case AlertSuccess:
		return base + "border-l-success"
	case AlertWarning:
		return base + "border-l-warning"
	default:
		return base + "border-l-danger"
	}
}

// alertIconClass はアイコンの大きさと状態色。
func alertIconClass(k AlertKind) string {
	const base = "mt-0.5 h-5 w-5 "
	switch k {
	case AlertInfo:
		return base + "text-info"
	case AlertSuccess:
		return base + "text-success"
	case AlertWarning:
		return base + "text-warning"
	default:
		return base + "text-danger"
	}
}

func alertIcon(k AlertKind) IconName {
	switch k {
	case AlertInfo:
		return IconInfoCircle
	case AlertSuccess:
		return IconCheckCircle
	case AlertWarning:
		return IconWarningTriangle
	default:
		return IconWarningCircle
	}
}

// alertRole は読み上げの強さ。注意・エラーは即時（alert）、お知らせ・成功は控えめ（status）。
func alertRole(k AlertKind) string {
	if k == AlertInfo || k == AlertSuccess {
		return "status"
	}
	return "alert"
}

// Alert はインラインアラート（アイコン＋見出し＋本文）。見出し（Title）は任意で、1 文で足りるエラーは Message だけで出す。状態は色だけでなく、アイコンと文言でも伝える。
// 応答全体の失敗（Recover・CSRF・404 など）、フォームのエラー、取得失敗・警告のバナーはすべてこれに載せる。
templ Alert(p AlertProps) {
	<div role={ alertRole(p.Kind) } data-alert class={ alertClass(p.Kind) } { p.Attrs... }>
		@Icon(alertIcon(p.Kind), alertIconClass(p.Kind))
		<div class="flex min-w-0 flex-1 flex-col gap-1">
			if p.Title != "" {
				<p class="font-semibold">{ p.Title }</p>
			}
			if p.Message != "" {
				<p>{ p.Message }</p>
			}
			{ children... }
		</div>
	</div>
}
