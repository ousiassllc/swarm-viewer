package atoms

// SpinnerSize はスピナーの大きさ。
type SpinnerSize string

// SpinnerSize の値。
const (
	SpinnerSmall  SpinnerSize = "sm"
	SpinnerMedium SpinnerSize = "md"
	SpinnerLarge  SpinnerSize = "lg"
)

// SpinnerProps は Spinner の入力。
type SpinnerProps struct {
	// ID は hx-indicator から参照する id（`#id`）。空なら id を付けない。
	ID string
	// Size は大きさ。未知の値は md。
	Size SpinnerSize
}

func spinnerSizeClass(s SpinnerSize) string {
	switch s {
	case SpinnerSmall:
		return "h-3 w-3"
	case SpinnerLarge:
		return "h-6 w-6"
	default:
		return "h-4 w-4"
	}
}

// Spinner は hx-indicator 用のローディング表示。表示の切り替えは app.css の .htmx-indicator が行う。
templ Spinner(p SpinnerProps) {
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		class={ "htmx-indicator inline-block animate-spin rounded-full border-2 border-slate-500 border-t-transparent", spinnerSizeClass(p.Size) }
		role="status"
		aria-label="読み込み中"
	></span>
}
