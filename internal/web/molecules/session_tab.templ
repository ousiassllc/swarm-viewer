package molecules

import (
	"github.com/ousiassllc/swarm-viewer/internal/web/atoms"
	"github.com/ousiassllc/swarm-viewer/internal/web/paths"
)

// SessionTabProps は SessionTab の入力。
type SessionTabProps struct {
	// ConnectionID は接続 ID（connections.id）。
	ConnectionID string
	// Session は tmux セッション名。
	Session string
	// Selected は選択中のタブか。
	Selected bool
}

func sessionTabClass(selected bool) string {
	if selected {
		return "hover-fade -mb-px border-b-2 border-accent py-2.5 text-sm text-ink"
	}
	return "hover-fade -mb-px border-b-2 border-transparent py-2.5 text-sm text-mute hover:text-ink"
}

// sessionTabAttrs は選択中のタブだけに aria-current を付ける。
func sessionTabAttrs(selected bool) templ.Attributes {
	if selected {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}

// SessionTab はセッションタブ 1 つ。選択でメイン領域（#main）を再取得する（FR-SESS-2）。
templ SessionTab(p SessionTabProps) {
	@atoms.NavLink(atoms.NavLinkProps{Href: paths.Session(p.ConnectionID, p.Session), Class: sessionTabClass(p.Selected), Attrs: sessionTabAttrs(p.Selected)}) {
		{ p.Session }
	}
}
