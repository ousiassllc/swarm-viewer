package molecules

import (
	"github.com/ousiassllc/swarm-viewer/internal/domain"
	"github.com/ousiassllc/swarm-viewer/internal/web/atoms"
	"github.com/ousiassllc/swarm-viewer/internal/web/format"
	"strconv"
)

// PaneCardProps は PaneCard の入力。
// 取得失敗で直前値を表示しているときのグレーアウトは領域（organisms.SnapshotView の #snapshot）が 1 回だけかける。
// opacity は入れ子で掛け算になるので、カード単体ではかけない（ガイド C5）。
type PaneCardProps struct {
	// Pane は表示するペイン。title・activity・note は信頼できない入力で、Templ のエスケープで文字列として描画する（NFR-SEC-10）。
	Pane domain.Pane
	// Highlight は attention の asking / stalled に該当するペインのとき true（強調表示する。機能要件 §7）。
	Highlight bool
	// ReportWaiting は attention の report_waiting に該当するペインのとき true（state バッジの隣に「報告待ち」を出す。機能要件 §7）。
	ReportWaiting bool
}

func paneCardClass(p PaneCardProps) string {
	base := "flex min-w-0 flex-col gap-1 rounded-lg border bg-surface p-4 text-sm"
	if p.Highlight {
		return base + " border-warning ring-2 ring-warning/40"
	}
	return base + " border-border"
}

func agentName(a *string) string {
	if a == nil {
		return ""
	}
	return *a
}

func activityText(p domain.Pane) string {
	if p.ActivityTruncated {
		return p.Activity + "…"
	}
	return p.Activity
}

func noteTooltip(n *domain.Note) string {
	if n == nil {
		return ""
	}
	return format.JoinNonEmpty("\n", n.Repo, joinLines(n.Items))
}

func joinLines(items []string) string {
	return format.JoinNonEmpty("\n", items...)
}

// PaneCard はペイン 1 つの読み取り専用カード。
// ボタン・フォーム・入力・リンク・hx-post/put/delete を持たない（機能要件 §4.4・FR-PANE）。
templ PaneCard(p PaneCardProps) {
	<article class={ paneCardClass(p) } data-pane-pos={ p.Pane.Pos }>
		<header class="flex flex-wrap items-center gap-2">
			<span class="font-mono text-xs text-ink" title={ p.Pane.CWD }>{ p.Pane.Pos }</span>
			if name := agentName(p.Pane.Agent); name != "" {
				@atoms.Badge(atoms.BadgeProps{Text: name, Tone: format.ToneMuted})
			}
			@atoms.Badge(atoms.BadgeProps{Text: format.StateLabel(p.Pane.State), Tone: format.StateTone(p.Pane.State)})
			if p.ReportWaiting {
				@atoms.Badge(atoms.BadgeProps{Text: format.AttentionLabel("report_waiting"), Tone: format.AttentionTone("report_waiting")})
			}
			if p.Pane.State == domain.StateStalled && p.Pane.ChangedAgo != "" {
				<span class="text-xs text-mute">{ p.Pane.ChangedAgo }</span>
			}
			if p.Pane.Elapsed != "" {
				<span class="ml-auto text-xs text-mute">{ p.Pane.Elapsed }</span>
			}
		</header>
		<p class="truncate text-ink" title={ format.JoinNonEmpty("\n", p.Pane.Title, p.Pane.CWD) }>{ p.Pane.Title }</p>
		if p.Pane.Activity != "" {
			<p class="truncate text-sm text-ink" title={ activityText(p.Pane) }>{ activityText(p.Pane) }</p>
		}
		@paneNote(p.Pane.Note)
	</article>
}

templ paneNote(n *domain.Note) {
	if repo, items, more := format.NoteSummary(n); repo != "" || len(items) > 0 {
		<div class="rounded-md border border-border bg-bone px-3 py-2 text-sm text-ink" title={ noteTooltip(n) }>
			if repo != "" {
				<p class="truncate font-mono text-mute">{ repo }</p>
			}
			if len(items) > 0 {
				<ul class="flex flex-col gap-(--list-gap)">
					for _, item := range items {
						<li class="flex items-center gap-(--list-marker-gap) before:size-(--list-marker-size) before:shrink-0 before:rounded-full before:bg-mute">
							<span class="truncate">{ item }</span>
						</li>
					}
				</ul>
			}
			if more > 0 {
				<p class="text-mute">{ "+" + strconv.Itoa(more) }</p>
			}
		</div>
	}
}
