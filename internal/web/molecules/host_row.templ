package molecules

import (
	"github.com/ousiassllc/swarm-viewer/internal/web/atoms"
	"github.com/ousiassllc/swarm-viewer/internal/web/format"
)

// HostRowProps は HostRow の入力。
type HostRowProps struct {
	// Label は項目名（「CPU」「スワップ」「/」など）。マウント名は信頼できない入力として扱う。
	Label string
	// Percent は使用率（%）。しきい値色は機能要件 §5.3 と同じ規則。
	Percent float64
	// Available が false のとき「—」を表示する（バー・数値なし）。
	Available bool
	// Detail は補足（「12.3 GB 空き」「なし」など）。空なら出さない。
	Detail string
	// NoBar が true のときバー・数値を出さず Detail だけ表示する（スワップなし）。
	NoBar bool
}

// HostRow はホスト負荷（CPU・スワップ・ディスク）の 1 行。
templ HostRow(p HostRowProps) {
	<div class="flex items-center gap-2 text-xs">
		<span class="w-16 shrink-0 truncate text-slate-400" title={ p.Label }>{ p.Label }</span>
		if !p.Available {
			<span class="text-slate-500" aria-label="取得できません">{ format.Dash }</span>
		} else if p.NoBar {
			<span class="text-slate-300">{ p.Detail }</span>
		} else {
			<div class="min-w-0 flex-1">
				@atoms.ProgressBar(atoms.ProgressBarProps{Percent: p.Percent, Tone: format.PercentTone(p.Percent), Label: p.Label})
			</div>
			<span class={ "w-12 shrink-0 text-right font-mono", valueClass(format.PercentTone(p.Percent)) }>{ format.Percent(p.Percent) }</span>
			if p.Detail != "" {
				<span class="shrink-0 text-slate-500">{ p.Detail }</span>
			}
		}
	</div>
}
