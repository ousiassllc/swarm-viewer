package molecules

import (
	"github.com/ousiassllc/swarm-viewer/internal/web/atoms"
	"github.com/ousiassllc/swarm-viewer/internal/web/format"
)

// HostRowProps は HostRow の入力。
type HostRowProps struct {
	// Label は項目名（「CPU」「メモリ」「スワップ」「/」など）。マウント名は信頼できない入力として扱う。
	Label string
	// Percent は使用率（%）。しきい値色は機能要件 §5.3 と同じ規則。
	Percent float64
	// Available が false のとき「—」を表示する（バー・数値なし）。
	Available bool
	// Detail は補足（「12.3 GB 空き」「1 GB / 4 GB」「なし」など）。空なら出さない。
	Detail string
	// NoBar が true のときバー・数値を出さず Detail だけ表示する（スワップなし）。
	NoBar bool
}

// hostRowText は値の列の文言（title 用）。率と補足を空白で区切る。
func hostRowText(p HostRowProps) string {
	return format.JoinNonEmpty(" ", format.Percent(p.Percent), p.Detail)
}

// HostRow はホスト負荷（CPU・メモリ・スワップ・ディスク）の 1 行。
// 行は 3 列のグリッド（ラベル=固定幅・バー=残り・値=固定幅）で、全行のバーの左端と右端がそろう。
// 値の列は率と補足を 1 つの要素にまとめて右寄せにし、はみ出したら truncate＋title。
// 「—」（取れない）と「なし」（スワップ無し）の行もバーの列を空にして同じ 3 列にのせる。
templ HostRow(p HostRowProps) {
	<div class="grid grid-cols-[4.5rem_minmax(0,1fr)_12rem] items-center gap-2 text-sm">
		<span class="truncate text-mute" title={ p.Label }>{ p.Label }</span>
		if !p.Available {
			<span></span>
			<span class="truncate text-right text-mute" aria-label="取得できません">{ format.Dash }</span>
		} else if p.NoBar {
			<span></span>
			<span class="truncate text-right text-ink" title={ p.Detail }>{ p.Detail }</span>
		} else {
			<div class="min-w-0">
				@atoms.ProgressBar(atoms.ProgressBarProps{Percent: p.Percent, Tone: format.PercentTone(p.Percent), Label: p.Label})
			</div>
			<span class="truncate text-right tabular-nums" title={ hostRowText(p) }>
				<span class={ "font-mono", valueClass(format.PercentTone(p.Percent)) }>{ format.Percent(p.Percent) }</span>
				if p.Detail != "" {
					<span class="font-mono text-ink">{ p.Detail }</span>
				}
			</span>
		}
	</div>
}
